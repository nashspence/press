# Copy into a private, ignored file with mode 0600 and replace all placeholders.
# One bucket, exact sha256/ prefix, with listFiles + writeFiles for upload.
# Hosted cleanup also needs deleteFiles; the same read/write key is supported.
B2_APPLICATION_KEY_ID=replace-me
B2_APPLICATION_KEY=replace-me
B2_BUCKET_ID=replace-me
B2_BUCKET_NAME=replace-me
